 typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="342900" indent="-342900" algn="just"><a:lnSpc><a:spcPct val="107000"/></a:lnSpc><a:spcAft><a:spcPts val="800"/></a:spcAft><a:buFont typeface="Symbol" panose="05050102010706020507" pitchFamily="18" charset="2"/><a:buChar char=""/></a:pPr><a:r><a:rPr lang="pt-BR" sz="2000" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>cópia simples do RG (com menos de 10 anos da expedição) e CPF ou CNH válida do solicitante, bem como do cônjuge; </a:t></a:r><a:endParaRPr lang="en-AU" sz="2000" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="342900" indent="-342900" algn="just"><a:lnSpc><a:spcPct val="107000"/></a:lnSpc><a:spcAft><a:spcPts val="800"/></a:spcAft><a:buFont typeface="Symbol" panose="05050102010706020507" pitchFamily="18" charset="2"/><a:buChar char=""/></a:pPr><a:r><a:rPr lang="pt-BR" sz="2000" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>certidão que comprove seu estado civil: se solteiro, juntar certidão de nascimento atualizada; se casado juntar certidão de casamento - se porventura existir pacto antenupcial deverá apresentar o mesmo, bem como o registro deste junto ao Registro de Imóveis competente; se separado/divorciado, juntar certidão de casamento com a devida averbação; e, se viúvo(a) juntar certidão de casamento atualizada e certidão de óbito do cônjuge). </a:t></a:r><a:endParaRPr lang="en-AU" sz="2000" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr algn="just"><a:lnSpc><a:spcPct val="107000"/></a:lnSpc><a:spcAft><a:spcPts val="800"/></a:spcAft></a:pPr><a:r><a:rPr lang="pt-BR" sz="2000" b="1" u="sng" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>**Se solteiro também será necessária uma declaração de não convivência em união estável</a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>: sendo os requerentes solteiros, apresentar declaração expressa de que não convivem em união estável, ou ainda, constar da inicial tal informação. </a:t></a:r><a:endParaRPr lang="en-AU" sz="2000" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr algn="just"><a:lnSpc><a:spcPct val="107000"/></a:lnSpc><a:spcAft><a:spcPts val="800"/></a:spcAft></a:pPr><a:r><a:rPr lang="pt-BR" sz="2000" b="1" u="sng" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>**Se solteiro e caso conviva em união estável</a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>: será necessário constar a qualificação completa das respectivas companheiras (os), bem como anuência das mesmas (os), a respeito da usucapião pretendida (art. 1.725 e art. 1.647, II, da Lei nº 10.406/02), ou mesmo a companheira (o) dependendo do caso também pode ser requerente (se ela também cumprir o requisito do tempo necessário à usucapião).</a:t></a:r><a:endParaRPr lang="en-AU" sz="2000" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="2837823334"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>