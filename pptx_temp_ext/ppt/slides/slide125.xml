ose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>Observação:</a:t></a:r><a:endParaRPr lang="en-AU" sz="2400" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="342900" lvl="0" indent="-342900" algn="just"><a:lnSpc><a:spcPct val="150000"/></a:lnSpc><a:spcAft><a:spcPts val="800"/></a:spcAft><a:buFont typeface="Symbol" panose="05050102010706020507" pitchFamily="18" charset="2"/><a:buChar char=""/></a:pPr><a:r><a:rPr lang="pt-BR" sz="2400" b="1" u="sng" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>Procuração ao advogado</a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2400" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>: O Requerente não pode solicitar sozinho a Usucapião diretamente ao Cartório de Registro de Imóveis, pois isso é atribuição do advogado. Então, o Requerente deverá assinar uma procuração ao advogado (ou a um defensor público) concedendo-lhe poderes especiais para requerer Usucapião extrajudicial em seu nome. Na procuração, não é necessária firma reconhecida</a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2400" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>.</a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2400" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t> E também assinará o Requerente em conjunto com o advogado.</a:t></a:r><a:endParaRPr lang="en-AU" sz="2400" b="1" kern="100"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:effectLst/><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr algn="ctr"><a:lnSpc><a:spcPct val="150000"/></a:lnSpc></a:pPr><a:endParaRPr lang="en-AU" sz="2400" b="1"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3433572203"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>