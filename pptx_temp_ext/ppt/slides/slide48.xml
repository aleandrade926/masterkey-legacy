000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>, onde a posse é exercida por um grupo de pessoas. O tempo de posse exigido é de </a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:schemeClr val="bg1"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>5 anos</a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>, mas o imóvel deve ser de </a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:schemeClr val="bg1"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>utilização coletiva </a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>e a </a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:schemeClr val="bg1"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>área não pode ser superior a 250m²</a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t> por possuidor.</a:t></a:r></a:p><a:p><a:pPr algn="just"><a:lnSpc><a:spcPct val="150000"/></a:lnSpc><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:schemeClr val="bg1"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>Tempo exigido</a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>: 5 anos de posse coletiva. 10, Lei 10.257 de 2001 - Estatuto da Cidade- A área que será usucapida, não deverá ultrapassar 250m² por possuidor, acrescendo ainda a necessidade de que </a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:schemeClr val="bg1"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>nenhum dos requerentes sejam proprietários de outros imóveis </a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>rurais ou urbanos. Caso contrário, a usucapião coletiva não poderá de ser aplicada. O lapso temporal previsto nesta modalidade é de 5 anos ininterruptos de </a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:schemeClr val="bg1"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>posse mansa e pacífica, ininterrupta</a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>, devendo todos os requerentes agirem com </a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:schemeClr val="bg1"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>ânimo de dono</a:t></a:r><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>.</a:t></a:r></a:p><a:p><a:pPr algn="just"><a:lnSpc><a:spcPct val="150000"/></a:lnSpc><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="pt-BR" sz="2000" b="1" dirty="0"><a:solidFill><a:srgbClr val="FF0066"/></a:solidFill><a:latin typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:ea typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/><a:cs typeface="Ebrima" panose="02000000000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>Relevância do tempo: Assim como nas outras modalidades, o tempo de posse é essencial para demonstrar a intenção de estabelecer a posse coletiva e garantir a segurança jurídica sobre a propriedade compartilhada</a:t></a:r><a:r><a:rPr lang="pt-BR" b="1" dirty="0"/><a:t>.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3483952263"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>